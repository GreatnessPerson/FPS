local optimizedCount = 0
local batchSize = 100

local function optimizeObject(obj)
    if not obj or not obj.Parent then return end
    
    local objType = obj.ClassName
    
    if objType == "ParticleEmitter" or objType == "Trail" or objType == "Smoke" or 
       objType == "Fire" or objType == "Sparkles" or objType == "Beam" then
        obj.Enabled = false
        return
    end
    
    if objType == "Explosion" then
        pcall(function() obj:Destroy() end)
        return
    end
    
    if obj:IsA("BasePart") then
        obj.CastShadow = false
        obj.Reflectance = 0
        return
    end
    
    if objType == "Decal" or objType == "Texture" then
        obj.Transparency = 1
        return
    end
    
    if objType == "PointLight" or objType == "SpotLight" or objType == "SurfaceLight" then
        obj.Enabled = false
        return
    end
    
    if objType == "Sky" or objType == "Atmosphere" or objType == "Clouds" then
        pcall(function() obj:Destroy() end)
        return
    end
end

local function optimizeInBatches()
    local descendants = workspace:GetDescendants()
    local total = #descendants
    
    task.spawn(function()
        for i = 1, total, batchSize do
            for j = i, math.min(i + batchSize - 1, total) do
                pcall(optimizeObject, descendants[j])
            end
            optimizedCount = optimizedCount + batchSize
            
            if i % 500 == 0 then
                task.wait()
            end
        end
    end)
end

optimizeInBatches()

workspace.DescendantAdded:Connect(function(obj)
    task.defer(function()
        pcall(optimizeObject, obj)
    end)
end)

local function optimizePlayer(character)
    if not character then return end
    
    task.spawn(function()
        task.wait(0.05)
        for _, v in pairs(character:GetDescendants()) do
            pcall(function()
                if v:IsA("Accessory") or v:IsA("Hat") then
                    for _, part in pairs(v:GetDescendants()) do
                        if part:IsA("BasePart") or part:IsA("MeshPart") then
                            part.CastShadow = false
                        end
                    end
                elseif v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") then
                    v:Destroy()
                end
            end)
        end
    end)
end

local function optimizeLocalCharacter(char)
    task.spawn(function()
        task.wait(0.05)
        for _, v in pairs(char:GetDescendants()) do
            pcall(function()
                if v:IsA("Accessory") or v:IsA("Hat") or v:IsA("Shirt") or 
                   v:IsA("Pants") or v:IsA("ShirtGraphic") then
                    v:Destroy()
                end
            end)
        end
    end)
end

if localPlayer.Character then
    optimizeLocalCharacter(localPlayer.Character)
end

localPlayer.CharacterAdded:Connect(optimizeLocalCharacter)

for _, player in pairs(players:GetPlayers()) do
    if player ~= localPlayer and player.Character then
        optimizePlayer(player.Character)
    end
end

players.PlayerAdded:Connect(function(player)
    if player == localPlayer then return end
    player.CharacterAdded:Connect(optimizePlayer)
end)

